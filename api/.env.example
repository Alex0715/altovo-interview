# Neon — use the POOLED connection string (host contains "-pooler").
# asyncpg disables its prepared-statement cache for this; see app/db.py.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Embeddings (the lexora gateway is chat-only, so these go direct to OpenAI)
OPENAI_API_KEY=sk-...

# Chat generation
LEXORA_API_KEY=...
LEXORA_BASE_URL=https://api.lexora.network
LEXORA_MODEL=gpt-5.4-mini

# Optional overrides (defaults in app/config.py)
# CHUNK_TARGET_TOKENS=700
# CHUNK_OVERLAP_TOKENS=100
# RETRIEVAL_TOP_K=8
# RETRIEVAL_CANDIDATES=20
# MIN_SIMILARITY=0.25
# CORS_ORIGINS=http://localhost:3000
